# GitTrace environment template.
# Copy to .env and fill in real values. Never commit .env.

# FalkorDB Cloud — from the instance "Connectivity → Connect" panel
FALKORDB_HOST=your-instance.hc-xxxx.us-central1.gcp.f2e0a955bb84.cloud
FALKORDB_PORT=54824
FALKORDB_USER=FalkorDB
FALKORDB_PASSWORD=your-password
# Local Docker (`docker compose up -d falkordb`): FALKORDB_HOST=localhost,
# FALKORDB_PORT=6379 and an empty FALKORDB_PASSWORD (no auth).

# LLM via LiteLLM (Gemini by default)
Gemini_API_Key=your-gemini-api-key
LITELLM_MODEL=gemini/gemini-flash-lite-latest
