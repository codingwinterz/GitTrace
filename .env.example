# GitTrace environment template.
# Copy to .env only if you need to change something. Never commit .env.

# FalkorDB: local Docker by default (`docker compose up -d falkordb`).
# These are the values used when nothing is set.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# A remote FalkorDB (e.g. FalkorDB Cloud) instead. `scan` then refuses to write
# graphs there (they include your source code) unless you pass --allow-remote;
# GitTrace never prints the host, port or password, only "local" or "remote".
# FALKORDB_HOST=your-instance.hc-xxxx.us-central1.gcp.f2e0a955bb84.cloud
# FALKORDB_PORT=54824
# FALKORDB_USER=FalkorDB
# FALKORDB_PASSWORD=your-password

# Model triage (gittrace scan) through LiteLLM; a local Ollama model by default.
# `--model` on the command line wins over GITTRACE_MODEL. `--no-llm` skips the model.
GITTRACE_MODEL=ollama/llama3.1:8b
# Summaries (gittrace explain) use their own model; GITTRACE_MODEL does not apply to them.
GITTRACE_EXPLAIN_MODEL=ollama/qwen2.5-coder:7b
# Seconds to wait for one reply (default 120; the first call also loads the model).
# GITTRACE_LLM_TIMEOUT=120
# Where Ollama listens, if not http://localhost:11434 (read by LiteLLM).
# OLLAMA_API_BASE=http://localhost:11434
