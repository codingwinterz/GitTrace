.env
.env.*
!.env.example

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

*.log

# Local debug scripts (one-off connectivity/auth probes, not part of the product)
debug/

*.bak

# Local Claude Code state
.claude/
skills-lock.json

# evaluation checkouts and tools (reproduced by eval/run_eval.py)
eval/.src/
eval/.bandit-venv/

# Package build output (python -m build)
/dist/
/build/

# Caches of linters and type checkers
.ruff_cache/
.mypy_cache/

# GitTrace's own cache when this repo is scanned (it also writes a `*` .gitignore inside)
.gittrace/

# Never part of this repo: the demo video project (node_modules, renders, captures)
node_modules/
/out/
/captures/
*.mp4
